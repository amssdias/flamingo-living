---
import { photos } from '../../data/photos';
import Icon from '../ui/Icon.astro';
import Photo from '../ui/Photo.astro';
---

<section class="container why">
  <h2 class="t-h2-sm why__title" data-reveal>¿Por qué Ciudad Flamingo?</h2>

  <div class="why__grid">
    <article class="why__card why__card--photo why__card--location" data-reveal>
      <Photo photo={photos.coastline} alt="" fill sizes="(min-width: 1100px) 50vw, 100vw" />
      <div class="why__scrim why__scrim--bottom" aria-hidden="true"></div>
      <div class="why__body why__body--on-photo">
        <Icon name="compass" weight="light" size={30} />
        <h3 class="why__heading why__heading--lg">Ubicación</h3>
        <p>Una zona privilegiada de Falcón, cerca del Caribe venezolano.</p>
      </div>
    </article>

    <article class="why__card why__card--teal" data-reveal>
      <Icon name="chart-line-up" weight="light" size={30} />
      <div>
        <h3 class="why__heading">Inversión</h3>
        <p>Terrenos con potencial para inversión y desarrollo futuro.</p>
      </div>
    </article>

    <article class="why__card why__card--sand" data-reveal>
      <Icon name="house-line" weight="light" size={30} />
      <div>
        <h3 class="why__heading">Tu propio proyecto</h3>
        <p>Parcelas donde cada propietario desarrolla su propia vivienda.</p>
      </div>
    </article>

    <article class="why__card why__card--photo why__card--life" data-reveal>
      <Photo photo={photos.familyBeach} alt="" fill sizes="(min-width: 640px) 50vw, 100vw" />
      <div class="why__scrim why__scrim--side" aria-hidden="true"></div>
      <div class="why__body why__body--on-photo">
        <Icon name="sun-horizon" weight="light" size={30} />
        <h3 class="why__heading">Estilo de vida</h3>
        <p>Naturaleza, tranquilidad, playa y otra forma de vivir.</p>
      </div>
    </article>
  </div>
</section>

<style>
  .why {
    padding-bottom: var(--section-space);
  }

  .why__title {
    margin-bottom: 48px;
  }

  .why__grid {
    display: grid;
    grid-template-columns: 1fr;
    grid-auto-rows: minmax(260px, auto);
    gap: 16px;
  }

  .why__card {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 32px;
    padding: 32px;
    border-radius: var(--radius-xl);
    overflow: hidden;
  }

  .why__card p {
    font-size: var(--fs-body);
    line-height: 1.55;
  }

  .why__card--photo {
    justify-content: flex-end;
    padding: 0;
    background: var(--color-night);
  }

  .why__card--location {
    min-height: 420px;
  }

  .why__card--teal {
    background: var(--color-teal-soft);
    color: var(--color-teal-deep);
  }

  .why__card--teal :global(.icon) {
    color: var(--color-teal-dark);
  }

  .why__card--teal p {
    color: var(--color-teal-text);
  }

  .why__card--sand {
    background: var(--color-sand);
    color: var(--color-sand-deep);
  }

  .why__card--sand :global(.icon) {
    color: var(--color-sand-ink);
  }

  .why__card--sand p {
    color: var(--color-sand-text);
  }

  .why__scrim {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  .why__scrim--bottom {
    background: linear-gradient(180deg, rgb(var(--scrim-rgb) / 0) 40%, rgb(var(--scrim-rgb) / 0.75) 100%);
  }

  .why__scrim--side {
    background: linear-gradient(90deg, rgb(var(--scrim-rgb) / 0.7) 0%, rgb(var(--scrim-rgb) / 0) 65%);
  }

  .why__body--on-photo {
    position: relative;
    padding: 32px;
    color: var(--color-on-dark);
  }

  .why__body--on-photo p {
    max-width: 34ch;
    color: var(--color-on-dark-muted);
  }

  .why__heading {
    margin: 0 0 8px;
    font-size: var(--fs-h3);
    font-weight: 500;
    letter-spacing: -0.02em;
  }

  .why__body--on-photo .why__heading {
    margin-top: 14px;
  }

  .why__heading--lg {
    font-size: 1.875rem;
  }

  .why__card--location .why__body--on-photo p {
    font-size: 1.0625rem;
  }

  /* Tablet: location and lifestyle take full rows, the two colour cards share one. */
  @media (min-width: 640px) {
    .why__grid {
      grid-template-columns: repeat(2, 1fr);
      grid-auto-rows: minmax(280px, auto);
    }

    .why__card--location,
    .why__card--life {
      grid-column: span 2;
    }
  }

  /* Desktop bento: location 2×2 on the left, the rest filling the right half. */
  @media (min-width: 1100px) {
    .why__grid {
      grid-template-columns: repeat(4, 1fr);
    }

    .why__card--location {
      grid-row: span 2;
    }
  }
</style>
