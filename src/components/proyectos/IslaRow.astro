---
import { islaUrl, type Isla } from '../../data/islas';
import { leadHref } from '../../lib/lead';
import { profileLabel } from '../../lib/profile';
import Button from '../ui/Button.astro';
import Photo from '../ui/Photo.astro';
import StatusBadge from '../ui/StatusBadge.astro';

interface Props {
  isla: Isla;
}

const { isla } = Astro.props;
const href = islaUrl(isla);
---

<article class="isla-row" data-profiles={isla.profiles.join(' ')} data-reveal>
  <div class="isla-row__info">
    <span class="isla-row__numeral" aria-hidden="true">{isla.numeral}</span>
    <div class="isla-row__body">
      <h3 class="isla-row__name">{isla.name}</h3>
      <div class="isla-row__meta">
        <StatusBadge status={isla.status} class="isla-row__status" />
        <ul class="isla-row__tags" aria-label="Dirigido a">
          {isla.profiles.map((profile) => <li class={`isla-row__tag isla-row__tag--${profile}`}>{profileLabel[profile]}</li>)}
        </ul>
      </div>
      <p class="isla-row__summary">{isla.summary}</p>
      <dl class="isla-row__facts tabular">
        {
          isla.facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.value}</dd>
            </div>
          ))
        }
      </dl>
      <div class="isla-row__actions">
        <Button href={href} size="sm">Ver proyecto</Button>
        <Button href={leadHref({ source: 'proyectos-lista', isla: isla.name })} variant="outline-soft" size="sm">
          Solicitar información
        </Button>
      </div>
    </div>
  </div>

  <div class="isla-row__photo">
    <Photo photo={isla.cover} alt="" ratio="16/10" class="media" sizes="(min-width: 900px) 50vw, 100vw" />
    {/* Overlay instead of a wrapping link: the photo credit already contains links. */}
    <a href={href} class="isla-row__photo-link" tabindex="-1" aria-hidden="true"></a>
  </div>
</article>

<style>
  .isla-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 380px), 1fr));
    gap: clamp(28px, 4vw, 64px);
    align-items: center;
    padding-block: clamp(40px, 5vw, 72px);
    border-top: 1px solid var(--color-line);
  }

  .isla-row__info {
    display: grid;
    gap: 12px;
  }

  .isla-row__numeral {
    min-width: 1.2ch;
    font-size: clamp(5.5rem, 12vw, 11rem);
    font-weight: 300;
    letter-spacing: -0.06em;
    line-height: 0.8;
    color: var(--color-teal);
  }

  .isla-row__name {
    font-size: 1.75rem;
    font-weight: 700;
    letter-spacing: 0.02em;
  }

  .isla-row__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    margin-top: 10px;
  }

  .isla-row :global(.isla-row__status) {
    color: var(--color-muted);
  }

  .isla-row__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .isla-row__tag {
    padding: 3px 10px;
    border-radius: var(--radius-pill);
    font-size: var(--fs-xs);
    font-weight: 500;
    white-space: nowrap;
  }

  .isla-row__tag--inversor {
    background: var(--color-teal-soft);
    color: var(--color-teal-dark);
  }

  .isla-row__tag--particular {
    background: var(--color-sand);
    color: var(--color-sand-ink);
  }

  .isla-row__summary {
    max-width: 40ch;
    margin-top: 18px;
    font-size: 1.0625rem;
    line-height: 1.6;
    color: var(--color-muted);
  }

  .isla-row__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 14px 24px;
    max-width: 40ch;
    margin: 20px 0 0;
  }

  .isla-row__facts dt {
    font-size: var(--fs-xs);
    color: var(--color-muted);
  }

  .isla-row__facts dd {
    margin: 2px 0 0;
    font-size: 0.9375rem;
    font-weight: 500;
  }

  .isla-row__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 24px;
  }

  .isla-row__photo {
    position: relative;
  }

  .isla-row__photo-link {
    position: absolute;
    inset: 0;
    z-index: 1;
  }

  @media (min-width: 560px) {
    .isla-row__info {
      grid-template-columns: auto 1fr;
      gap: clamp(20px, 3vw, 40px);
      align-items: start;
    }

    .isla-row__body {
      padding-top: 8px;
    }
  }
</style>
