---
import type { Isla } from '../../data/islas';
import Photo from '../ui/Photo.astro';

interface Props {
  isla: Isla;
}

const { isla } = Astro.props;
const [main, ...rest] = isla.gallery;
---

<section class="container section-sm gallery">
  <h2 class="t-h2-sm gallery__title" data-reveal>Galería</h2>
  <div class="gallery__grid">
    <div class="gallery__item gallery__item--main" data-reveal>
      <Photo photo={main} class="media" sizes="(min-width: 900px) 66vw, 100vw" />
    </div>
    {
      rest.map((photo, index) => (
        <div class="gallery__item" data-reveal>
          <Photo
            photo={photo}
            class:list={['media', { 'media--sand': index === 0 }]}
            sizes="(min-width: 640px) 33vw, 100vw"
          />
        </div>
      ))
    }
  </div>
</section>

<style>
  .gallery__title {
    margin-bottom: 36px;
  }

  .gallery__grid {
    display: grid;
    grid-template-columns: 1fr;
    grid-auto-rows: clamp(220px, 60vw, 320px);
    gap: 16px;
  }

  @media (min-width: 640px) {
    .gallery__grid {
      grid-template-columns: 1fr 1fr;
      grid-auto-rows: clamp(220px, 30vw, 320px);
    }

    .gallery__item--main {
      grid-column: span 2;
    }
  }

  @media (min-width: 900px) {
    .gallery__grid {
      grid-template-columns: 2fr 1fr;
      grid-auto-rows: clamp(220px, 22vw, 320px);
    }

    .gallery__item--main {
      grid-column: auto;
      grid-row: span 2;
    }
  }
</style>
