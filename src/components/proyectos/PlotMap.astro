---
import type { Isla } from '../../data/islas';
import { plotStatusLabel, type Plot } from '../../data/plots';
import { site } from '../../data/site';
import { leadHref } from '../../lib/lead';
import Button from '../ui/Button.astro';
import Chip from '../ui/Chip.astro';
import Icon from '../ui/Icon.astro';

interface Props {
  isla: Isla;
  plots: Plot[];
}

const { isla, plots } = Astro.props;
const showStatus = site.showAvailability;
const showLegend = showStatus && isla.status !== 'proximamente';
const legend = (['disponible', 'reservada', 'vendida'] as const).map((status) => ({
  status,
  label: plotStatusLabel[status],
}));
const note = showStatus
  ? 'Datos de ejemplo. Disponibilidad conectada al CRM en la versión final.'
  : 'Consulta con un asesor la disponibilidad actual de cada parcela.';
---

<section id="plano" class="plot-map" data-plot-map data-isla={isla.name}>
  <div class="container section-sm">
    <h2 class="t-h2-sm" data-reveal>Plano y distribución de parcelas</h2>

    <div class="plot-map__layout">
      <div class="media plot-map__plan" data-reveal>
        {
          isla.plan ? (
            <img src={isla.plan.src} alt={isla.plan.alt} loading="lazy" />
          ) : (
            <div class="plot-map__plan-placeholder">
              <Icon name="map-trifold" weight="light" size={36} />
              <p>El plano oficial de {isla.name} se publicará próximamente.</p>
            </div>
          )
        }
      </div>

      <div class="plot-map__panel" data-reveal>
        <div class="plot-map__filters" role="group" aria-label="Filtrar por tamaño">
          <Chip size="sm" pressed data-filter="all">Todas</Chip>
          {
            isla.sizes.map((size) => (
              <Chip size="sm" data-filter={size}>
                {size} m²
              </Chip>
            ))
          }
        </div>

        <ul class="plot-map__grid" aria-label={`Parcelas de ${isla.name}`}>
          {
            plots.map((plot) => {
              const status = showStatus ? plot.status : 'neutral';
              const statusLabel = showStatus ? plotStatusLabel[plot.status] : '';
              return (
                <li>
                  <button
                    type="button"
                    class:list={['plot', `plot--${status}`]}
                    aria-pressed="false"
                    aria-label={`Parcela ${plot.id}, ${plot.size} m²${statusLabel && `, ${statusLabel}`}`}
                    data-plot={plot.id}
                    data-size={plot.size}
                    data-status={status}
                    data-status-label={statusLabel}
                  >
                    <span class="plot__number">{plot.number}</span>
                    <span class="plot__size tabular">{plot.size}</span>
                  </button>
                </li>
              );
            })
          }
        </ul>

        {
          showLegend && (
            <ul class="plot-map__legend">
              {legend.map((item) => (
                <li>
                  <span class:list={['plot-map__swatch', `plot--${item.status}`]} aria-hidden="true" />
                  {item.label}
                </li>
              ))}
            </ul>
          )
        }
        <p class="plot-map__note">{note}</p>

        <div class="plot-map__selection" aria-live="polite">
          <p class="plot-map__hint" data-hint>
            <Icon name="hand-pointing" size={20} />Selecciona una parcela para ver su detalle.
          </p>
          <div class="plot-map__picked" data-picked hidden>
            <div>
              <p class="plot-map__picked-id">Parcela <span data-picked-id></span></p>
              <p class="plot-map__picked-size tabular">
                <span data-picked-size></span> m²
                <span class="plot-map__picked-status" data-picked-status></span>
              </p>
            </div>
            <Button href={leadHref({ source: 'proyecto-parcela', isla: isla.name })} size="sm" data-picked-cta>Consultar esta parcela</Button>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { leadHref } from '../../lib/lead';

  document.querySelectorAll<HTMLElement>('[data-plot-map]').forEach((root) => {
    const isla = root.dataset.isla ?? '';
    const filters = root.querySelectorAll<HTMLButtonElement>('[data-filter]');
    const plots = root.querySelectorAll<HTMLButtonElement>('[data-plot]');
    const hint = root.querySelector<HTMLElement>('[data-hint]');
    const picked = root.querySelector<HTMLElement>('[data-picked]');
    const pickedId = root.querySelector('[data-picked-id]');
    const pickedSize = root.querySelector('[data-picked-size]');
    const pickedStatus = root.querySelector<HTMLElement>('[data-picked-status]');
    const pickedCta = root.querySelector<HTMLAnchorElement>('[data-picked-cta]');

    filters.forEach((filter) =>
      filter.addEventListener('click', () => {
        const value = filter.dataset.filter;
        filters.forEach((el) => el.setAttribute('aria-pressed', String(el === filter)));
        plots.forEach((plot) =>
          plot.toggleAttribute('data-dimmed', value !== 'all' && plot.dataset.size !== value),
        );
      }),
    );

    plots.forEach((plot) =>
      plot.addEventListener('click', () => {
        const { plot: id = '', size = '', status = '', statusLabel = '' } = plot.dataset;
        plots.forEach((el) => el.setAttribute('aria-pressed', String(el === plot)));

        if (pickedId) pickedId.textContent = id;
        if (pickedSize) pickedSize.textContent = size;
        if (pickedStatus) {
          pickedStatus.textContent = statusLabel;
          pickedStatus.dataset.status = status;
        }
        if (pickedCta) pickedCta.href = leadHref({ source: 'proyecto-parcela', isla, plot: id, size });
        if (hint) hint.hidden = true;
        if (picked) picked.hidden = false;
      }),
    );
  });
</script>

<style>
  .plot-map {
    background: var(--color-mist);
  }

  .plot-map__layout {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 420px), 1fr));
    gap: 24px;
    align-items: start;
    margin-top: 40px;
  }

  .plot-map__plan {
    aspect-ratio: 4 / 3;
    border: 1px solid var(--color-line-cool);
  }

  .plot-map__plan img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .plot-map__plan-placeholder {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 10px;
    padding: 24px;
    text-align: center;
    font-size: var(--fs-sm);
    color: var(--color-muted);
    border: 1.5px dashed var(--color-line-strong);
    border-radius: inherit;
  }

  .plot-map__panel {
    padding: clamp(20px, 2.4vw, 32px);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-xl);
    background: var(--color-paper);
  }

  .plot-map__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .plot-map__grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(52px, 1fr));
    gap: 6px;
    margin-top: 24px;
    padding: 0;
    list-style: none;
  }

  .plot {
    --plot-bg: var(--color-soon-bg);
    --plot-line: var(--color-sold-line);
    --plot-ink: var(--color-ink-soft);

    width: 100%;
    aspect-ratio: 1 / 1.15;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;
    padding: 6px;
    border: 1px solid var(--plot-line);
    border-radius: var(--radius-sm);
    background: var(--plot-bg);
    color: var(--plot-ink);
    transition:
      opacity var(--duration-base) ease,
      transform var(--duration-fast) ease;
  }

  .plot:hover {
    transform: translateY(-2px);
  }

  .plot[aria-pressed='true'] {
    border: 2px solid var(--color-ink);
  }

  .plot[data-dimmed] {
    opacity: 0.22;
  }

  .plot--disponible {
    --plot-bg: var(--color-teal-soft);
    --plot-line: var(--color-teal);
    --plot-ink: var(--color-teal-dark);
  }

  .plot--reservada {
    --plot-bg: var(--color-sand);
    --plot-line: var(--color-sand-border);
    --plot-ink: var(--color-sand-ink);
  }

  .plot--vendida {
    --plot-bg: var(--color-sold-bg);
    --plot-line: var(--color-sold-line);
    --plot-ink: var(--color-sold-ink);
  }

  .plot--proximamente {
    --plot-ink: var(--color-muted);
  }

  .plot__number {
    font-size: 11px;
    font-weight: 500;
  }

  .plot__size {
    font-size: var(--fs-xs);
    font-weight: 700;
  }

  .plot-map__legend {
    display: flex;
    flex-wrap: wrap;
    gap: 18px;
    margin-top: 18px;
    padding: 0;
    list-style: none;
    font-size: var(--fs-xs);
    color: var(--color-muted);
  }

  .plot-map__legend li {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .plot-map__swatch {
    width: 14px;
    height: 14px;
    border: 1px solid var(--plot-line);
    border-radius: 4px;
    background: var(--plot-bg);
  }

  .plot-map__note {
    margin-top: 14px;
    font-size: var(--fs-xs);
    color: var(--color-muted);
  }

  .plot-map__selection {
    min-height: 88px;
    margin-top: 22px;
    padding-top: 22px;
    border-top: 1px solid var(--color-line);
  }

  .plot-map__hint {
    display: flex;
    align-items: center;
    gap: 10px;
    font-size: 0.9375rem;
    color: var(--color-muted);
  }

  .plot-map__picked {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
  }

  .plot-map__picked-id {
    font-size: var(--fs-sm);
    color: var(--color-muted);
  }

  .plot-map__picked-size {
    margin-top: 4px;
    font-size: 1.625rem;
    font-weight: 500;
  }

  .plot-map__picked-status {
    font-size: 0.9375rem;
    color: var(--color-ink-soft);
  }

  .plot-map__picked-status[data-status='disponible'] {
    color: var(--color-teal-dark);
  }

  .plot-map__picked-status[data-status='reservada'] {
    color: var(--color-sand-ink);
  }

  .plot-map__picked-status[data-status='vendida'] {
    color: var(--color-sold-ink);
  }

  .plot-map__picked-status[data-status='proximamente'] {
    color: var(--color-muted);
  }
</style>
