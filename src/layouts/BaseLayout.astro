---
import '../styles/global.css';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import { site } from '../data/site';
import { url } from '../lib/paths';

interface Props {
  title?: string;
  description: string;
  /** The page starts with a full-bleed image hero under a transparent header. */
  heroOverlay?: boolean;
}

const { title, description, heroOverlay = false } = Astro.props;
const pageTitle = title ? `${title} · ${site.name}` : `${site.name} · ${site.development}, Falcón`;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="theme-color" content="#0f3a40" />
    <link rel="icon" type="image/svg+xml" href={url('/favicon.svg')} />
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link rel="preconnect" href="https://images.unsplash.com" />
    <link
      rel="stylesheet"
      href="https://api.fontshare.com/v2/css?f[]=satoshi@300,400,500,700&display=swap"
    />
  </head>
  <body>
    <Header overlay={heroOverlay} />
    <main class:list={{ 'offset-header': !heroOverlay }}>
      <slot />
    </main>
    <Footer />

    <script>
      import { initReveal } from '../scripts/reveal';
      initReveal();
    </script>
  </body>
</html>

<style>
  .offset-header {
    padding-top: var(--header-height);
  }
</style>
