---
import FinalCta from '../components/home/FinalCta.astro';
import Highlights from '../components/home/Highlights.astro';
import HomeHero from '../components/home/HomeHero.astro';
import Intro from '../components/home/Intro.astro';
import Investors from '../components/home/Investors.astro';
import IslasCarousel from '../components/home/IslasCarousel.astro';
import Location from '../components/home/Location.astro';
import PlotSizePicker from '../components/home/PlotSizePicker.astro';
import WhyBento from '../components/home/WhyBento.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
